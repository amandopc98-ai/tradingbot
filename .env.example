# Alpaca API credentials (paper or live, matching ALPACA_PAPER below)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# true = paper trading endpoint (default, safe), false = live trading with real money
ALPACA_PAPER=true

# How often the main loop ticks, in seconds. Stop-loss checks run every tick;
# strategy signals only evaluate once a new bar for that symbol's timeframe closes.
POLL_INTERVAL_SECONDS=60

# Fraction of account equity risked per 1x ATR adverse move (0.01 = 1%)
RISK_PCT_PER_TRADE=0.01

# Max fraction of buying power allowed in a single symbol at entry (0.30 = 30%)
MAX_ALLOCATION_PCT=0.30

# Allow short-selling on equities (SPY/QQQ/GLD/USO). Crypto (BTC/USD) is always long-only
# because Alpaca crypto trading is spot-only and does not support short selling.
ALLOW_SHORTING=true
